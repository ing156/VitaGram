# Data encryption (key made of console buttons) - English text, awaiting translation
vault.title = Data encryption
vault.ask.title = Protect your data?
vault.ask.body = VitaGram can encrypt everything it keeps on the memory card: the Telegram database, photos, videos, stickers, voice messages and settings.\n\nYou unlock it at every start with either a key made of console buttons or a typed passphrase (stronger).\n\nIf you forget the key, the data cannot be recovered; you would have to sign in to Telegram again. You can change this later in Start > Settings.
vault.ask.footer = {cross} Encrypt data    {circle} Not now
vault.setup.title = Create a key
vault.new.title = New key
vault.setup.hint = Press at least {0} buttons: the D-pad directions, {cross} {circle} {triangle} {square}. Use many different buttons and no simple pattern. Press Start when done.
vault.setup.confirm_title = Repeat the key
vault.setup.confirm_hint = Enter the same sequence again to make sure you remember it.
vault.current.title = Current key
vault.current.hint = Enter your current key and press Start.
vault.disable.title = Turn off encryption
vault.unlock.title = Enter your key
vault.unlock.hint = Enter your key with the console buttons and press Start.
vault.unlock.hint_disabling = Encryption is being turned off. Enter your key to finish decrypting your data.
vault.entry.footer = Start: OK    L: delete    R: clear    Select: cancel
vault.unlock.footer = Start: unlock    L: delete    R: clear    Select: forgot key
