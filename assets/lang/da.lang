vault.method.title = Choose how to unlock
vault.method.buttons = {cross}  Console buttons\nQuick to enter: D-pad, {cross} {circle} {triangle} {square}. Good protection with a long sequence (12 or more presses).
vault.method.text = {square}  Text passphrase\nStronger: a typed phrase of at least 10 characters, entered with the system keyboard. Best for long-term protection. Use plain letters, digits and symbols: accented letters can be typed in different ways and may not match later.
