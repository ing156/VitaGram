# Keyboard data (UTF-8 characters; rows separated by |).
@keyboard.symbols.0 = 1234567890!@#$
@keyboard.symbols.1 = %^&*()-_=+[]{}
@keyboard.symbols.2 = \\|;:'",.<>/?`~
@keyboard.popup., = ;:
@keyboard.popup.. = ?!…
@keyboard.badge = NL
@keyboard.rows = qwertyuiop|asdfghjkl|zxcvbnm
