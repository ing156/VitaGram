vault.unavailable = This key was made on another console.
vault.error = Could not save the key.
vault.changed = Key changed.
vault.forgot.title = Erase all data?
vault.forgot.body = Without the key the encrypted data cannot be read.\n\nYou can erase all VitaGram data, including the Telegram sign-in, and start over.
vault.forgot.footer = {triangle} Erase everything    {circle} Back
vault.erasing = Erasing data...
