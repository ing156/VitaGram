  "notes": [
    "Source sizes are physical pixels for Vita frame buffer 960x544.",
    "Nine-slice margin order is left,top,right,bottom; coordinates are top-left and width/height.",
    "No logos, avatar images, user-specific text, or user-specific tabs are baked into textures.",
    "Theme and per-component colors are static PNGs; real text stays in current app renderer.",
    "Full-screen wave wallpapers are pre-rendered offline as opaque RGBA PNGs: background_960x544.png is the default and background_alt_960x544.png is an optional stronger version.",
    "v1.2: added six battery status sprites per theme using previously unused 64px cells; all existing icon source rectangles unchanged."
  ],
  "battery_icons": {
    "states": [
      "battery_0",
      "battery_25",
      "battery_50",
      "battery_75",
      "battery_100",
      "battery_charging"
    ],
    "recommended_size": [
      20,
      20
    ],
    "source_size": [
      32,
      32
    ],
    "display_rules": {
      "charging": "battery_charging",
      "not_charging": {
        "0-12": "battery_0",
        "13-37": "battery_25",
        "38-62": "battery_50",
        "63-87": "battery_75",
        "88-100": "battery_100"
      }
    },
    "note": "Visual-only: obtain actual battery percentage and charging state from the application/system. Do not use these icon names as fixed percentages in the UI."
  },
  "theme_sources": {
    "vhbb": {
      "project": "Vita Homebrew Browser",
      "author": "devnoname120 and VHBB contributors",
      "url": "https://github.com/devnoname120/vhbb",
