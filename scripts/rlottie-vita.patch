 void renderer::NullLayer::updateContent() {}
 
+namespace {
+
+constexpr float kMaxPolyPoints = 1024.0f;
+
+static float estimatedPointCount(const model::Property<float> &points)
+{
+    if (points.isStatic()) {
+        float pts = points.value();
+        if (!std::isfinite(pts)) return 1.0f;
+        return std::min(std::max(pts, 1.0f), kMaxPolyPoints);
+    }
+
+    float maxPts = 1.0f;
+    for (const auto &frame : points.animation().frames_) {
+        maxPts = std::max(maxPts, frame.value_.start_);
+        maxPts = std::max(maxPts, frame.value_.end_);
+    }
+    if (!std::isfinite(maxPts)) return 1.0f;
+    return std::min(std::max(maxPts, 1.0f), kMaxPolyPoints);
+}
+
+static size_t estimatedPathPoints(const model::Path *path)
+{
+    if (!path) return 1;
+
+    if (path->mShape.isStatic()) {
+        return std::max<size_t>(1, path->mShape.value().mPoints.size());
+    }
+
+    size_t maxPts = 1;
+    for (const auto &frame : path->mShape.animation().frames_) {
+        maxPts = std::max(maxPts, size_t(frame.value_.start_.mPoints.size()));
+        maxPts = std::max(maxPts, size_t(frame.value_.end_.mPoints.size()));
+    }
+    return std::min(maxPts, size_t(kMaxPolyPoints));
+}
+
