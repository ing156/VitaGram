+#if defined(__vita__)
+/*
+ * The Vita's pthread-embedded builds every rwlock from two mutexes and a
+ * condition variable, each backed by kernel semaphores. OpenSSL 3 creates a
+ * lock per certificate, key and connection, so loading a CA bundle of about
+ * 120 roots exhausts the process's kernel objects and later lock creation
+ * fails silently. These locks live in user memory instead: one atomic word,
+ * bit 31 = writer, the rest = number of readers. A waiter spins briefly and
+ * then sleeps, so a high-priority thread cannot starve a lower-priority lock
+ * holder on the same core (the Vita scheduler is strictly priority-based).
+ * Readers may nest, as with pthread rwlocks; writers do not.
+ */
+#include <psp2/kernel/threadmgr.h>
+
+#define VITA_LOCK_WRITER 0x80000000u
+
+static void vita_lock_backoff(unsigned int *spins)
+{
+    if (++*spins < 64)
+        return;
+    sceKernelDelayThread(50);
+}
+
+CRYPTO_RWLOCK *CRYPTO_THREAD_lock_new(void)
+{
+    /* Don't set error, to avoid recursion blowup. */
+    return OPENSSL_zalloc(sizeof(unsigned int));
+}
+
+__owur int CRYPTO_THREAD_read_lock(CRYPTO_RWLOCK *lock)
+{
+    unsigned int *word = lock, spins = 0, seen;
+
+    for (;;) {
+        seen = __atomic_load_n(word, __ATOMIC_RELAXED);
+        if ((seen & VITA_LOCK_WRITER) == 0
+            && __atomic_compare_exchange_n(word, &seen, seen + 1, 1,
+                __ATOMIC_ACQUIRE, __ATOMIC_RELAXED))
+            return 1;
+        vita_lock_backoff(&spins);
+    }
+}
+
+__owur int CRYPTO_THREAD_write_lock(CRYPTO_RWLOCK *lock)
+{
+    unsigned int *word = lock, spins = 0, expected;
+
+    for (;;) {
+        expected = 0;
+        if (__atomic_compare_exchange_n(word, &expected, VITA_LOCK_WRITER, 1,
+                __ATOMIC_ACQUIRE, __ATOMIC_RELAXED))
+            return 1;
+        vita_lock_backoff(&spins);
+    }
+}
+
+int CRYPTO_THREAD_unlock(CRYPTO_RWLOCK *lock)
+{
+    unsigned int *word = lock;
+    unsigned int seen = __atomic_load_n(word, __ATOMIC_RELAXED);
+
+    /* Only the holder unlocks: a set writer bit means this thread is the writer. */
+    if ((seen & VITA_LOCK_WRITER) != 0) {
+        __atomic_store_n(word, 0, __ATOMIC_RELEASE);
+        return 1;
+    }
+    if (seen == 0)
+        return 0;
+    __atomic_fetch_sub(word, 1, __ATOMIC_RELEASE);
+    return 1;
+}
+
+void CRYPTO_THREAD_lock_free(CRYPTO_RWLOCK *lock)
+{
+    OPENSSL_free(lock);
+}
+
