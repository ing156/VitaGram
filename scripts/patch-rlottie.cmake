if(NOT DEFINED SOURCE_FILE OR NOT EXISTS "${SOURCE_FILE}")
  message(FATAL_ERROR "Pass -DSOURCE_FILE=/path/to/vimageloader.cpp")
endif()
file(READ "${SOURCE_FILE}" original)
set(patched "${original}")
set(newline "\n")
if(original MATCHES "\r\n")
  set(newline "\r\n")
endif()

# 1. Static builds do not need dlfcn.
set(marker "// VitaGram: static builds do not need dlfcn")
string(FIND "${patched}" "${marker}" already_patched)
if(NOT already_patched EQUAL -1)
  message(STATUS "rlottie static-loader fix already applied")
else()
  # Match just the include directive, independent of upstream surrounding code
  # and indentation. Keep every other byte, including local modifications.
  string(REGEX MATCHALL "#[ \t]*include[ \t]+<dlfcn\\.h>" matches "${patched}")
  list(LENGTH matches count)
  if(NOT count EQUAL 1)
    message(FATAL_ERROR "Expected exactly one dlfcn.h include; source left unchanged")
  endif()
  list(GET matches 0 directive)
  string(FIND "${patched}" "#include \"config.h\"" config_position)
  string(FIND "${patched}" "${directive}" include_position)
  if(config_position EQUAL -1 OR config_position GREATER include_position)
    message(FATAL_ERROR "config.h must precede dlfcn.h; source left unchanged")
  endif()
  string(REPLACE "${directive}"
    "${marker}${newline}#ifdef LOTTIE_IMAGE_MODULE_SUPPORT${newline}${directive}${newline}#endif"
    patched "${patched}")
endif()

# 2. No raster images: Telegram stickers never embed them, and the static build would otherwise
#    decode any PNG/JPEG inside an animation with stb_image, without size limits. With the loader
#    pointers left empty, VImageLoader::load() returns an empty bitmap and stb_image is unreachable.
set(image_marker "// VitaGram: embedded raster images are refused")
string(FIND "${patched}" "${image_marker}" images_patched)
if(NOT images_patched EQUAL -1)
  message(STATUS "rlottie image-loader refusal already applied")
else()
  string(REGEX MATCHALL "imageLoad[ \t]*=[ \t]*lottie_image_load" load_matches "${patched}")
  string(REGEX MATCHALL "imageFromData[ \t]*=[ \t]*lottie_image_load_from_data" data_matches "${patched}")
  list(LENGTH load_matches load_count)
  list(LENGTH data_matches data_count)
  if(NOT load_count EQUAL 1 OR NOT data_count EQUAL 1)
    message(FATAL_ERROR "Expected one static imageLoad/imageFromData assignment; source left unchanged")
  endif()
  list(GET load_matches 0 load_assignment)
  list(GET data_matches 0 data_assignment)
  string(REPLACE "${load_assignment}" "${image_marker}${newline}        imageLoad = nullptr" patched "${patched}")
  string(REPLACE "${data_assignment}" "imageFromData = nullptr" patched "${patched}")
endif()

if(NOT patched STREQUAL original)
  if(NOT EXISTS "${SOURCE_FILE}.vitagram-before-static-fix")
    configure_file("${SOURCE_FILE}" "${SOURCE_FILE}.vitagram-before-static-fix" COPYONLY)
  endif()
  file(WRITE "${SOURCE_FILE}" "${patched}")
  message(STATUS "Patched rlottie image loader; original backup retained")
endif()
