+
+// Drain ready pictures independently of input: one AU need not yield one picture immediately.
+static int vita_receive_frame(AVCodecContext *avctx, AVFrame *frame)
+{
+    for (;;) {
+        AVPacket packet = {0};
+        int got_frame = 0;
+        int ret = vita_decode(avctx, frame, &got_frame, NULL);
+        if (ret < 0 || got_frame)
+            return ret;
+
+        ret = ff_decode_get_packet(avctx, &packet);
+        if (ret == AVERROR_EOF) {
+            ret = vita_decode(avctx, frame, &got_frame, &packet);
+            return ret < 0 ? ret : got_frame ? 0 : AVERROR_EOF;
+        }
+        if (ret < 0)
+            return ret;
+        ret = vita_decode(avctx, frame, &got_frame, &packet);
+        av_packet_unref(&packet);
+        if (ret < 0 || got_frame)
+            return ret;
+    }
 }
 
