#!/usr/bin/env bash
set -euo pipefail
: "${VITASDK:?Set VITASDK}"
cd "$(dirname "$0")/.."
root="$PWD/external/rlottie-vita"
compatibility_patch="$PWD/scripts/rlottie-static-loader.patch"
mkdir -p "$root"
if ! test -d "$root/source"; then
    git clone --depth 1 https://github.com/Samsung/rlottie.git "$root/source"
fi
# Keep the checked-out revision on subsequent builds; no automatic source updates.
git -C "$root/source" rev-parse HEAD
if git -C "$root/source" apply --check "$compatibility_patch"; then
    git -C "$root/source" apply "$compatibility_patch"
elif git -C "$root/source" apply --reverse --check "$compatibility_patch"; then
    printf 'Static image-loader compatibility patch already applied.\n'
else
    printf 'Cannot apply rlottie compatibility patch; source left unchanged.\n' >&2
    exit 1
fi
cmake -S "$root/source" -B "$root/build" \
    -DCMAKE_TOOLCHAIN_FILE="$VITASDK/share/vita.toolchain.cmake" \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
    -DCMAKE_INSTALL_PREFIX="$root/install" -DLIB_INSTALL_DIR="$root/install/lib" \
    -DBUILD_SHARED_LIBS=OFF -DLOTTIE_MODULE=OFF -DLOTTIE_THREAD=OFF \
    -DLOTTIE_CACHE=OFF -DLOTTIE_TEST=OFF
cmake --build "$root/build" -j"$(nproc)"
cmake --install "$root/build"
mkdir -p "$root/install/share"
cp "$root/source/COPYING" "$root/install/share/rlottie-COPYING"
mkdir -p "$root/install/share/rlottie-licenses"
cp -R "$root/source/licenses/." "$root/install/share/rlottie-licenses/"
