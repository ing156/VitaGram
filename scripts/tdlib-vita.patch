diff --git a/tdutils/td/utils/VitaTrace.h b/tdutils/td/utils/VitaTrace.h
new file mode 100644
index 0000000..b4486fa
--- /dev/null
+++ b/tdutils/td/utils/VitaTrace.h
@@ -0,0 +1,29 @@
+#pragma once
+#include <cstdint>
+
+// Optional embedding hooks. No event payloads, actor names or keys cross here.
+namespace td {
+enum class VitaPhase : unsigned { Idle, Actor, Poll, SocketRead, SocketWrite, Factorize, DhCheck, Dns,
+                                 FileIo, LogWrite, SocketConnect, FileSync, FileMeta };
+#if defined(__vita__) || defined(VITAGRAM_TD_TRACE_TEST)
+extern "C" uint64_t vitagram_td_enter(unsigned phase) __attribute__((weak));
+extern "C" void vitagram_td_leave(uint64_t previous) __attribute__((weak));
+// Directory of the file being opened/stat'ed/synced, for slow-operation reports.
+extern "C" void vitagram_td_path(const char* path) __attribute__((weak));
+inline void vita_trace_path(const char* path) { if (vitagram_td_path && path) vitagram_td_path(path); }
+class VitaTrace {
+ public:
+  explicit VitaTrace(VitaPhase phase) {
+    if (vitagram_td_enter && vitagram_td_leave) previous_ = vitagram_td_enter(static_cast<unsigned>(phase));
+  }
+  ~VitaTrace() { if (vitagram_td_enter && vitagram_td_leave) vitagram_td_leave(previous_); }
+  VitaTrace(const VitaTrace &) = delete;
+  VitaTrace &operator=(const VitaTrace &) = delete;
+ private:
+  uint64_t previous_ = 0;
+};
+#else
+class VitaTrace { public: explicit VitaTrace(VitaPhase) {} };
+inline void vita_trace_path(const char*) {}
+#endif
+}  // namespace td
