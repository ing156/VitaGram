+// Vita exFAT scans a directory linearly for every open/stat, so profile photos, thumbnails,
+// photos and stickers are spread over buckets of 32 counter names ("file_<id>"): one scan stays short however
+// many files exist. Files already stored flat keep working: their paths are kept by the app.
+static string bucket_dir_for(FileType file_type, const string &dir, CSlice name) {
+  if (file_type != FileType::ProfilePhoto && file_type != FileType::Thumbnail && file_type != FileType::Photo &&
+      file_type != FileType::Sticker) {
+    return dir;
+  }
+  Slice slice = name;
+  if (!begins_with(slice, "file_")) {
+    return dir;
+  }
+  slice.remove_prefix(5);
+  size_t digits = 0;
+  while (digits < slice.size() && digits < 9 && slice[digits] >= '0' && slice[digits] <= '9') {
+    digits++;
+  }
+  if (digits == 0) {
+    return dir;
+  }
+  return PSTRING() << dir << 'b' << to_integer<int32>(slice.substr(0, digits)) / 32 << TD_DIR_SLASH;
+}
