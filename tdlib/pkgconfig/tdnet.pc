prefix=/usr/local/vitasdk/arm-vita-eabi

Name: tdnet
Description: Telegram Library - Net
Version: 1.7.8

CFlags: -I"${prefix}/include"
Libs: -L"${prefix}/lib" -ltdnet
Requires.private: tdutils tdactor
Libs.private: -L"/usr/local/vitasdk/arm-vita-eabi/lib" -l:libssl.a -L"/usr/local/vitasdk/arm-vita-eabi/lib" -l:libcrypto.a -L"/usr/local/vitasdk/arm-vita-eabi/lib" -l:libz.a
